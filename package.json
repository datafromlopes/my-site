{
  "name": "datafromlopes",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": "Personal site of Diego Lopes — Lead Data Engineer & NLP Researcher.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && npm run prerender",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "prerender": "node scripts/prerender.mjs",
    "preview": "wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write ."
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.7.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@shikijs/rehype": "^3.9.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.22",
    "prettier": "^3.9.6",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "^7.0.6",
    "wrangler": "^4.28.0"
  }
}
